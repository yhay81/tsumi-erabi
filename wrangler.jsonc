{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tsumi-erabi",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "tsumi-erabi.yhay81.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tsumi-erabi",
      "database_id": "44aaebb9-3788-4709-bbed-ad60fdd1a256",
    },
  ],
  "triggers": {
    "crons": ["17 19 * * *"],
  },
}
